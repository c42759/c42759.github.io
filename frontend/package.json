    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.1",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3"
